{
  "name": "tokens-wrapped",
  "compatibility_date": "2026-11-19",
  // The site is static files; worker/index.js handles only card uploads (/api/card) and shared cards (/c/<id>).
  "main": "worker/index.js",
  "observability": {
    "enabled": false
  },
  "routes": [
    { "pattern": "tokenswrapped.com", "custom_domain": true },
    { "pattern": "www.tokenswrapped.com", "custom_domain": true }
  ],
  "workers_dev": true,
  "assets": {
    "directory": "site",
    "binding": "ASSETS"
  },
  // Posted card images, each deleted after 90 days, plus per-IP upload counters.
  "kv_namespaces": [{ "binding": "CARDS", "id": "fc5d0bb8374541d7ad61465959737210" }]
}
